{
  "name": "sach-chuyen-tay",
  "private": true,
  "description": "Sách Chuyền Tay — nền tảng mua bán sách cũ (monorepo: web + api + shared)",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @sct/api",
    "dev:web": "npm run dev -w @sct/web",
    "build": "npm run build -w @sct/api && npm run build -w @sct/web",
    "start": "npm run start -w @sct/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "npm run db:generate -w @sct/api",
    "db:migrate": "npm run db:migrate -w @sct/api",
    "db:seed": "npm run db:seed -w @sct/api",
    "cf:dev": "npm run build -w @sct/web && node scripts/cf-setup.mjs --local && wrangler dev --port 8788",
    "cf:deploy": "npm run build -w @sct/web && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "cf:setup": "node scripts/cf-setup.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "wrangler": "^4.168.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
