# Dùng cho `npm run cf:setup` (triển khai lên Cloudflare: D1 + R2 + Workers).
# Sao chép thành .env.production — file đó KHÔNG được commit (đã có trong .gitignore).
# Không cần chuỗi kết nối CSDL: D1 nằm ngay trong tài khoản Cloudflare của bạn.

# Tài khoản quản trị đầu tiên (chỉ tạo khi D1 chưa có tài khoản nào). Mật khẩu ≥ 12 ký tự.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=doi-mat-khau-that-dai-va-kho-doan

# true → nạp 24 đầu sách mẫu (chỉ thêm, không ghi đè dữ liệu đã có).
SEED_SAMPLE_DATA=false
