# URL gốc của API. Mặc định "/api/v1" — khi dev, Vite proxy "/api" sang http://localhost:4000.
# Khi deploy web và api khác domain, đặt URL đầy đủ, ví dụ:
# VITE_API_BASE_URL=https://api.sachchuyentay.vn/api/v1

# (Chỉ dùng khi dev) địa chỉ API mà Vite proxy tới
# VITE_DEV_API_PROXY=http://localhost:4000
