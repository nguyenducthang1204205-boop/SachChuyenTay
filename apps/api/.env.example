# Môi trường: development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# --- Cơ sở dữ liệu ---
# SQLite (libsql) khi chạy bằng Node — không cần cài gì. ":memory:" = trong bộ nhớ (test).
# Trên Cloudflare dùng D1 (cấu hình trong wrangler.jsonc), cùng lược đồ & migration.
DATABASE_URL=file:.data/sct.db

# --- Ảnh tải lên (bìa sách, ảnh khách gửi) ---
# Khi chạy bằng Node: lưu vào thư mục này. Trên Cloudflare Workers dùng R2 (wrangler.jsonc).
UPLOADS_DIR=.data/uploads

DB_AUTO_MIGRATE=true
DB_SEED_IF_EMPTY=true

# --- HTTP ---
# Danh sách origin được phép gọi API (phân cách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173
# Số proxy đứng trước API (0 nếu chạy trực tiếp; 1 nếu sau nginx / load balancer)
TRUST_PROXY=0
# Giới hạn số request ghi (đặt hàng, gửi form) mỗi phút / IP
WRITE_RATE_LIMIT_PER_MINUTE=20

# --- Nghiệp vụ ---
WELCOME_COUPON_CODE=CHUYENTAY10

# --- Quản trị ---
# Tài khoản quản trị đầu tiên, chỉ tạo khi hệ thống chưa có tài khoản nào.
# Dev/test mặc định: admin@sachchuyentay.vn / admin12345. PRODUCTION BẮT BUỘC đặt giá trị riêng.
# ADMIN_EMAIL=admin@sachchuyentay.vn
# ADMIN_PASSWORD=doi-mat-khau-manh-o-day
ADMIN_NAME=Quản trị viên
ADMIN_SESSION_TTL_HOURS=12
